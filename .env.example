# Database connection string
# Local SQLite (Default zero-config): file:./dev.db
# PostgreSQL (Production / Docker): postgresql://postgres:postgres@localhost:5432/billflow?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Tokens
JWT_SECRET="your-secure-random-secret-key-here"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Account Credentials (Optional)
DEMO_USER_EMAIL="demo@billflow.dev"
DEMO_USER_PASSWORD="password123"
